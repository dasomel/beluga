# Beluga environment variable overrides — sanitized template, safe to commit.
#
# Beluga never stores real secrets in a .env file: every service credential is
# generated at bootstrap time with `openssl rand` and stored only in the
# Kubernetes Secret `beluga-credentials` (see scripts/credentials.sh and
# SECURITY.md). This file documents the *non-secret* environment overrides
# that scripts/common/env.sh honors if already set in the shell — it does not
# replace configs/cluster.env, which remains the committed cluster topology
# source of truth.
#
# Usage: copy values you want to override into your shell environment before
# running `make up` / `bash scripts/up.sh`. Do not create a real `.env` file
# containing secrets — none of these variables are secrets.

# Hypervisor provider: vmware_fusion (arm64) or virtualbox (amd64).
# Defaults to the value in configs/cluster.env when unset.
# VAGRANT_PROVIDER=vmware_fusion

# Force-enable/disable the 48GB+ optional governance stack (OpenMetadata +
# OpenSearch) regardless of auto-detected host RAM profile.
# ENABLE_OPENMETADATA=false

# Force-enable/disable the Trino worker (in addition to the coordinator)
# regardless of auto-detected host RAM profile.
# TRINO_WORKER_ENABLED=false

# Path to an isolated kubeconfig, used by tests/ and scripts/credentials.sh.
# This machine is shared by multiple concurrent Kubernetes sessions — always
# point at an isolated file, never the shared ~/.kube/config (see CLAUDE.md).
# KUBECONFIG=/tmp/beluga-kubeconfig.yaml
