# Beluga Cluster Environment Configuration
# D1: Subnet 192.168.77.x (기존 클러스터 충돌 완전 방지)
# D8: 호스트 RAM 감지 기반 VM 사이징

# Provider Config (vmware_fusion / virtualbox)
VAGRANT_PROVIDER="vmware_fusion"

# Network Config
SUBNET_PREFIX="192.168.77"
MASTER_IP="192.168.77.10"
WORKER1_IP="192.168.77.21"
WORKER2_IP="192.168.77.22"
WORKER3_IP="192.168.77.23"
METALLB_IP_RANGE="192.168.77.200-192.168.77.220"

# Kubernetes Version
K8S_VERSION="1.35.0"
BOX_NAME="dasomel/ubuntu-26.04-xfs"

# Default RAM Sizing (32GB Host Profile)
MASTER_CPUS=2
MASTER_MEMORY=4096

WORKER_CPUS=4
WORKER_MEMORY=8192

# Domain Registry (*.beluga.local)
# /etc/hosts: 127.0.0.1 trino.beluga.local airflow.beluga.local superset.beluga.local catalog.beluga.local s3.beluga.local argocd.beluga.local
DOMAIN_TRINO="trino.beluga.local"
DOMAIN_AIRFLOW="airflow.beluga.local"
DOMAIN_SUPERSET="superset.beluga.local"
DOMAIN_FLINK="flink.beluga.local"
DOMAIN_CATALOG="catalog.beluga.local"
DOMAIN_S3="s3.beluga.local"
DOMAIN_ARGOCD="argocd.beluga.local"
