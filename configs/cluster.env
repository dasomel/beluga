# Beluga Cluster Environment Configuration
# D1: Subnet 192.168.77.x (기존 클러스터 충돌 완전 방지)
# D8: 호스트 RAM 감지 기반 VM 사이징

# Provider Config (virtualbox / vmware_fusion)
VAGRANT_PROVIDER="virtualbox"

# Network Config
SUBNET_PREFIX="192.168.77"
MASTER_IP="192.168.77.10"
WORKER1_IP="192.168.77.21"
WORKER2_IP="192.168.77.22"
WORKER3_IP="192.168.77.23"
METALLB_IP_RANGE="192.168.77.200-192.168.77.220"

# Kubernetes Version
K8S_VERSION="1.35.0"
BOX_NAME="dasomel/ubuntu-26.04-xfs"

# Default RAM Sizing (32GB Host Profile)
MASTER_CPUS=2
MASTER_MEMORY=4096

WORKER_CPUS=4
WORKER_MEMORY=8192

# Port Registry (Host Port Forwards)
HOST_PORT_KAFKA=9094
HOST_PORT_LAKEKEEPER=8181
HOST_PORT_TRINO=8080
HOST_PORT_AIRFLOW=8085
HOST_PORT_SUPERSET=8088
HOST_PORT_FLINK=8081
HOST_PORT_SEAWEED_S3=8333
HOST_PORT_SEAWEED_FILER=8888
HOST_PORT_GRAFANA=3000
HOST_PORT_PROMETHEUS=9090
HOST_PORT_ARGOCD=8443
