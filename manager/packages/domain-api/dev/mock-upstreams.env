# Environment for running the Domain API against the fake upstreams (packages/domain-api/dev/mock-upstreams.mjs).
# DUMMY token (`dev-dummy-token`) and DUMMY data: not a secret, never use with real services.
# Plain KEY=value lines, valid for both a POSIX shell and `docker compose --env-file`.
#
#   Terminal 1 (from manager/):  npm run dev:upstreams
#   Terminal 2 (from manager/):  (set -a; . packages/domain-api/dev/mock-upstreams.env; set +a; PORT=8796 npm run dev:api)
#
# The mock listens on loopback, so no BELUGA_UPSTREAM_ALLOW_INSECURE_BEARER is needed (the adapters refuse a
# bearer token over plain http to a non-loopback host unless that flag is set; compose.upstreams.yaml sets it
# because the compose service name is not loopback).
NODE_ENV=development
AUTH_MODE=disabled

BELUGA_FLINK_REST_URL=http://127.0.0.1:8781

BELUGA_TRINO_ENABLED=true
BELUGA_TRINO_BASE_URL=http://127.0.0.1:8780
BELUGA_TRINO_TOKEN=dev-dummy-token
# Explicitly empty: an inherited real *_TOKEN_FILE takes precedence over *_TOKEN and would send a REAL token
# to the fake. Empty values count as unset.
BELUGA_TRINO_TOKEN_FILE=
BELUGA_TRINO_HISTORY_ACK=shared-service-credential

BELUGA_LAKEKEEPER_ENABLED=true
BELUGA_LAKEKEEPER_BASE_URL=http://127.0.0.1:8782
BELUGA_LAKEKEEPER_WAREHOUSES=beluga_lake
BELUGA_LAKEKEEPER_TOKEN=dev-dummy-token
BELUGA_LAKEKEEPER_TOKEN_FILE=

# Also neutralise inherited settings that would change where or how the dummy token is sent.
BELUGA_UPSTREAM_ALLOW_INSECURE_BEARER=false
BELUGA_TRINO_USER=

# Token-file variant (the file is re-read on every call; it must exist, be a regular file and hold a valid
# token). Replace the two *_TOKEN / empty *_TOKEN_FILE pairs above with, using an ABSOLUTE path:
#   BELUGA_TRINO_TOKEN_FILE=/abs/path/to/manager/packages/domain-api/dev/mock-upstreams/dev-token
#   BELUGA_LAKEKEEPER_TOKEN_FILE=/abs/path/to/manager/packages/domain-api/dev/mock-upstreams/dev-token
# The checked-in file is mode 0644, so startup logs a "world-readable" warning; that is expected for a dummy.
