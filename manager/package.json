{
  "name": "beluga-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/web",
    "dev:api": "npm run dev --workspace=packages/domain-api",
    "dev:upstreams": "node packages/domain-api/dev/mock-upstreams.mjs",
    "build": "npm run typecheck && npm run build --workspace=packages/web",
    "preview": "npm run preview --workspace=packages/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json --noEmit",
    "audit": "node scripts/ci/check-dependency-vulnerabilities.mjs && node scripts/ci/check-license-policy.mjs",
    "policyctl": "bash scripts/ensure-policyctl-deps.sh && npm run policyctl --workspace=packages/policy-compiler --"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
