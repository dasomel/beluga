#cloud-config
# Beluga bastion: SSH 점프 호스트 + squid 포워드 프록시(사설 노드의 유일한 egress 경로).

hostname: bastion
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true

# D-KAKAO-16: VPC DHCP DNS(169.254.169.253)가 새 VPC 의 모든 VM 에서 타임아웃 난다(2026-10-16 라이브 실측,
# dig/ping 실패, 인터넷 IP 직접 접속은 정상). packages 가 apt 이름 해석에 실패해 squid 가 안 떴다. bootcmd 는
# packages 보다 먼저 돌므로 여기서 resolved 에 공용 upstream 을 깔고 재시작한다. VPC DNS 는 그대로 뒤에 남아
# dnsmasq resolv-file(/run/systemd/resolve/resolv.conf)에 함께 실린다.
# 비용: bastion 의 DNS 질의가 공용 리졸버로도 나간다. 탈출구: bastion_upstream_dns = [] 이면 이 블록을 통째로
# 생략해 VPC DNS 만 쓴다(user_data 만 바뀌면 기존 인스턴스는 교체되지 않으므로 -replace 필요).
%{ if length(upstream_dns) > 0 ~}
bootcmd:
  - mkdir -p /etc/systemd/resolved.conf.d
  - printf '[Resolve]\nDNS=%s\n' '${join(" ", upstream_dns)}' > /etc/systemd/resolved.conf.d/beluga-upstream.conf
  - systemctl restart systemd-resolved
%{ endif ~}

packages:
  - squid
  - dnsmasq

write_files:
  # Ubuntu 기본 squid.conf 는 Safe_ports/SSL_ports 거부 규칙 뒤에서 conf.d 를 include 한다 →
  # CONNECT 는 443 으로만 제한된 채 VPC 대역만 추가 허용된다(그 외는 기본 deny all).
  - path: /etc/squid/conf.d/beluga.conf
    permissions: "0644"
    content: |
      acl beluga_vpc src ${vpc_cidr}
      http_access allow beluga_vpc
      # 사설 노드가 받는 대용량 아티팩트는 어차피 1회성 — 디스크 캐시를 쓰지 않는다.
      cache deny all
      # D-KAKAO-15: AAAA 를 걸러 주는 로컬 dnsmasq 로 해석한다. VPC 는 IPv4 전용인데 squid 6 은
      # 받은 첫 주소(IPv6)로 붙다가 폴백하지 않아 get.helm.sh CONNECT 가 503 이 됐다(2026-10-16 라이브 실측,
      # narwhal 과 같은 원인). squid 6 에는 dns_v4_first 가 없어서 해석기에서 거른다.
      dns_nameservers 127.0.0.1
  # dnsmasq: 127.0.0.1 에서만 듣고(systemd-resolved 의 127.0.0.53 과 공존) AAAA 를 버린다.
  # upstream 은 resolved 의 실제 서버 목록(stub 이 아님)이라 자기 자신에게 되묻지 않는다.
  - path: /etc/dnsmasq.d/beluga.conf
    permissions: "0644"
    content: |
      listen-address=127.0.0.1
      bind-interfaces
      filter-AAAA
      domain-needed
      bogus-priv
      resolv-file=/run/systemd/resolve/resolv.conf
  - path: /etc/ssh/sshd_config.d/99-beluga.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes

runcmd:
  - systemctl restart ssh
  # dnsmasq 가 먼저 떠야 한다: squid 가 해석기 없이 시작하면 실패한 조회를 캐시한다(narwhal 실측).
  - systemctl enable --now dnsmasq
  - systemctl restart dnsmasq
  - systemctl enable --now squid
  - systemctl restart squid
  - echo "cloud-init completed" > /var/lib/cloud/beluga-init-done
