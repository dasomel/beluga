#cloud-config
# Beluga 노드 부트스트랩 (Terraform templatefile). k3s/Cilium/플랫폼 설치는 여기서 하지 않는다 —
# csp/kakao-cloud/scripts/kakao-up.sh 가 기존 scripts/cluster/*.sh 를 순서대로 실행한다.
# 이 파일은 그 스크립트들이 읽는 입력(/etc/beluga/*, 프록시 환경)만 깔아 둔다.

hostname: ${node_name}
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true

write_files:
  # Vagrantfile 의 provision 셸이 쓰는 것과 동일한 형식(02-k8s-init.sh 가 source 한다).
  - path: /etc/beluga/node.env
    permissions: "0644"
    content: |
      ROLE=${role}
      NODE_NAME=${node_name}
      NODE_IP=${node_ip}
  # scripts/common/env.sh 가 cluster.env 뒤에 source 하는 클라우드 오버라이드(Vagrant 서브넷 값을 덮어쓴다).
  # APISIX_LB_IP 는 MetalLB IP 가 아니라 apisix-gateway 의 고정 ClusterIP(values-kakao.yaml, D-KAKAO-2).
  - path: /etc/beluga/cluster.override.env
    permissions: "0644"
    content: |
      MASTER_IP="${master_ip}"
      APISIX_LB_IP="${apisix_cluster_ip}"
      BASE_DOMAIN="${base_domain}"
      BELUGA_PROFILE=64
      BELUGA_LB_MODE=nodeport
  # 프록시 환경(scripts/common/env.sh 가 set -a 로 source). 대소문자 둘 다 필요: curl 은 소문자
  # http_proxy 만, 일부 도구는 대문자만 읽는다. NO_PROXY 에 VPC/파드/서비스 CIDR 가 빠지면 클러스터
  # 내부 트래픽이 프록시로 새므로 terraform 이 변수로 넘긴 값을 그대로 쓴다.
  - path: /etc/default/beluga-proxy
    permissions: "0644"
    content: |
      HTTP_PROXY=${proxy_url}
      HTTPS_PROXY=${proxy_url}
      http_proxy=${proxy_url}
      https_proxy=${proxy_url}
      NO_PROXY=${no_proxy}
      no_proxy=${no_proxy}
  - path: /etc/profile.d/beluga-proxy.sh
    permissions: "0644"
    content: |
      # 로그인 셸(수동 helm/curl)에서도 동일한 프록시를 쓴다.
      set -a
      . /etc/default/beluga-proxy
      set +a
  - path: /etc/apt/apt.conf.d/95beluga-proxy
    permissions: "0644"
    content: |
      Acquire::http::Proxy "${proxy_url}";
      Acquire::https::Proxy "${proxy_url}";
  - path: /etc/ssh/sshd_config.d/99-beluga.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes

runcmd:
  - systemctl restart ssh
  # kakao-up.sh 가 레포를 여기로 rsync 한다(BELUGA_SRC=/opt/beluga, Vagrant 의 /vagrant 대응).
  - install -d -o ubuntu -g ubuntu /opt/beluga /opt/beluga/.kube
  - echo "cloud-init completed" > /var/lib/cloud/beluga-init-done
