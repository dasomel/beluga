# Beluga on Kakao Cloud — 입력 변수.
# 자격증명과 admin_cidrs 는 기본값이 없다(필수). terraform.tfvars 는 gitignore 대상이다.

#####################################################################
# Authentication
#####################################################################
variable "application_credential_id" {
  description = "Kakao Cloud Application Credential ID"
  type        = string
}

variable "application_credential_secret" {
  description = "Kakao Cloud Application Credential Secret"
  type        = string
  sensitive   = true
}

#####################################################################
# Access control
#####################################################################
variable "admin_cidrs" {
  description = "CIDRs allowed to SSH into the bastion (the only public SSH entry). Required; 0.0.0.0/0 is rejected because the bastion has a public IP. Example: [\"203.0.113.4/32\"]."
  type        = list(string)

  validation {
    condition     = length(var.admin_cidrs) > 0
    error_message = "admin_cidrs must contain at least one CIDR."
  }

  validation {
    condition     = alltrue([for cidr in var.admin_cidrs : cidr != "0.0.0.0/0"])
    error_message = "admin_cidrs must not include 0.0.0.0/0 - restrict to explicit operator CIDR(s)."
  }

  validation {
    condition     = alltrue([for cidr in var.admin_cidrs : can(cidrhost(cidr, 0))])
    error_message = "each entry in admin_cidrs must be a valid CIDR block (e.g. 203.0.113.4/32)."
  }
}

variable "nodeport_source_cidrs" {
  description = "Sources allowed to reach the gateway NodePorts 31080/31443 on the nodes. null = the VPC CIDR (NLB health checks/members). Widen only if the NLB turns out to preserve client source IPs (README: first-apply risks)."
  type        = list(string)
  default     = null
}

#####################################################################
# Naming / SSH key
#####################################################################
variable "name_prefix" {
  description = "Prefix for every resource name"
  type        = string
  default     = "beluga"
}

variable "key_name" {
  description = "Kakao keypair name to create (the key itself is generated by Terraform)"
  type        = string
  default     = "beluga-kakao"
}

variable "ssh_key_path" {
  description = "Where the generated private key is written (0600). Relative to the directory tofu runs in; keep it under generated/ (gitignored)."
  type        = string
  default     = "./generated/beluga-kakao.pem"
}

#####################################################################
# Network
#####################################################################
variable "availability_zone" {
  description = "Availability zone"
  type        = string
  default     = "kr-central-2-a"
}

variable "vpc_cidr" {
  description = "VPC CIDR block (must not overlap the k3s pod 10.42.0.0/16 or service 10.43.0.0/16 ranges)"
  type        = string
  default     = "172.16.0.0/16"

  validation {
    condition     = can(cidrhost(var.vpc_cidr, 0))
    error_message = "vpc_cidr must be a valid CIDR block."
  }
}

variable "vpc_default_subnet_cidr" {
  description = "CIDR of the subnet Kakao Cloud auto-creates with the VPC"
  type        = string
  default     = "172.16.255.0/24"
}

variable "subnet_cidr" {
  description = "Cluster subnet CIDR. Nodes get fixed IPs: master-1 = host .10, worker-1..N = .21.. (Vagrant scheme)"
  type        = string
  default     = "172.16.0.0/24"

  validation {
    condition     = can(cidrhost(var.subnet_cidr, 0))
    error_message = "subnet_cidr must be a valid CIDR block."
  }
}

variable "bastion_ip_offset" {
  description = "Host offset of the bastion in the cluster subnet. Pinned (not auto-assigned) so the bastion can never take a node's fixed IP, and so node cloud-init can reference the proxy address without depending on the bastion resource. Verify the address is outside Kakao's reserved low range."
  type        = number
  default     = 5
}

variable "pod_cidr" {
  description = "k3s default cluster (pod) CIDR — used only for NO_PROXY; 02-k8s-init.sh does not override it"
  type        = string
  default     = "10.42.0.0/16"
}

variable "service_cidr" {
  description = "k3s default service CIDR — used only for NO_PROXY; 02-k8s-init.sh does not override it"
  type        = string
  default     = "10.43.0.0/16"
}

variable "apisix_cluster_ip" {
  description = "Fixed ClusterIP of the apisix-gateway Service (D-KAKAO-2). Must equal apisix.service.clusterIP in gitops/charts/beluga-platform/values-kakao.yaml and lie inside service_cidr."
  type        = string
  default     = "10.43.0.200"
}

variable "base_domain" {
  description = "Platform base domain (configs/cluster.env BASE_DOMAIN)"
  type        = string
  default     = "local.beluga.internal"
}

#####################################################################
# Compute
#####################################################################
variable "image_name" {
  description = "OS image name (the Vagrant box is Ubuntu 26.04; use \"Ubuntu 26.04\" if the console lists it). Verify in the console."
  type        = string
  default     = "Ubuntu 24.04"
}

variable "master_flavor" {
  description = "Master flavor. Profile 64 sizes the master at 2 vCPU / 6 GiB; the nearest Kakao flavor at or above that is 4 vCPU / 8 GiB. Verify the flavor name in the console."
  type        = string
  default     = "t1i.xlarge"
}

variable "worker_flavor" {
  description = "Worker flavor. Profile 64 sizes workers at 4 vCPU / 12 GiB; verify the name in the console — a 4 vCPU / 16 GiB flavor is the closest fit if your project offers one, otherwise 8 vCPU / 16 GiB."
  type        = string
  default     = "t1i.2xlarge"
}

variable "worker_count" {
  description = "Number of workers (profile 64 = 3). The master is always a single k3s server."
  type        = number
  default     = 3

  validation {
    condition     = var.worker_count >= 1 && var.worker_count <= 10
    error_message = "worker_count must be between 1 and 10."
  }
}

variable "volume_size" {
  description = "Boot volume size in GB (PVCs live on node disks via k3s local-path)"
  type        = number
  default     = 100

  validation {
    condition     = var.volume_size >= 50 && var.volume_size <= 1000
    error_message = "volume_size must be between 50 and 1000 GB."
  }
}

#####################################################################
# Bastion
#####################################################################
variable "bastion_flavor" {
  description = "Bastion flavor (SSH jump host + squid forward proxy)"
  type        = string
  default     = "t1i.small"
}

variable "bastion_volume_size" {
  description = "Bastion boot volume size in GB"
  type        = number
  default     = 30

  validation {
    condition     = var.bastion_volume_size >= 20 && var.bastion_volume_size <= 200
    error_message = "bastion_volume_size must be between 20 and 200 GB."
  }
}

#####################################################################
# Gateway NodePorts (must match values-kakao.yaml apisix.service.nodePorts)
#####################################################################
variable "gateway_http_node_port" {
  description = "APISIX gateway HTTP NodePort"
  type        = number
  default     = 31080
}

variable "gateway_https_node_port" {
  description = "APISIX gateway HTTPS NodePort"
  type        = number
  default     = 31443
}
